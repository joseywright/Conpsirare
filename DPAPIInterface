// ============================================
// DONORPERFECT AIRTABLE INTEGRATION 
// ============================================

// ----------------------------
// INPUT VARIABLES
// ----------------------------
let inputConfig = input.config();

let recordId = inputConfig.recordId;
let firstName = inputConfig.firstName || "";
let lastName = inputConfig.lastName || "";
let email = inputConfig.email || "";
let zipCode = inputConfig.zipCode || "";
let rsvp = inputConfig.rsvp || "";
let eventName = "Test Event";

// ----------------------------
// CONFIGURATION
// ----------------------------
const API_KEY = "XXX";
const table = base.getTable("Form Responses");

const DP_ENDPOINT =
  "https://www.donorperfect.net/prod/xmlrequest.asp";

const USER_ID = "AirtableIntegration";

// ----------------------------
// HELPERS
// ----------------------------
function escapeDP(value) {
  if (!value) return "";
  return value.replace(/'/g, "''");
}

async function updateStatus(status, message, matchCount = null) {
  let updateFields = {
    "DP Sync Status": { name: status },
    "DP Sync Message": message,
    "Last Sync Attempt": new Date().toISOString()
  };

  try {
    updateFields["DP Match Count"] = matchCount;
  } catch (e) {}

  await table.updateRecordAsync(recordId, updateFields);
}

// ----------------------------
// GENERIC XML PARSER
// ----------------------------
function parseDonorId(xml) {
  let match = xml.match(/donor_id.*?value='(\d+)'/);
  return match ? match[1] : null;
}

// ----------------------------
// SQL SEARCH (EMAIL-BASED)
// ----------------------------
async function sqlSearch(email, lastName, firstName = null) {

  let whereClause = `email='${escapeDP(email)}' and last_name='${escapeDP(lastName)}'`;

  if (firstName) {
    whereClause += ` and first_name='${escapeDP(firstName)}'`;
  }

  let url =
    `${DP_ENDPOINT}?apikey=${API_KEY}` +
    `&action=select donor_id from dp where ${whereClause}`;

  let res = await fetch(url);
  let xml = await res.text();

  let donorId = parseDonorId(xml);

  return {
    donorId,
    raw: xml
  };
}

// ----------------------------
// FALLBACK SEARCH (dp_donorsearch)
// ----------------------------
async function dpSearch(firstName, lastName, zip) {

  let url =
    `${DP_ENDPOINT}?apikey=${API_KEY}` +
    `&action=dp_donorsearch` +
    `&params=` +
    `@donor_id=null,` +
    `@last_name='${escapeDP(lastName)}',` +
    `@first_name='${escapeDP(firstName)}',` +
    `@opt_line=null,` +
    `@address=null,` +
    `@city=null,` +
    `@state=null,` +
    `@zip='${escapeDP(zip)}',` +
    `@country=null,` +
    `@filter_id=null,` +
    `@user_id='${USER_ID}'`;

  let res = await fetch(url);
  let xml = await res.text();

  let matches = [...xml.matchAll(/<record>/g)];
  let count = matches.length;

  if (count > 1) {
    return { status: "REVIEW", matchCount: count };
  }

  if (count === 1) {
    return {
      status: "FOUND",
      matchCount: 1,
      donorId: parseDonorId(xml)
    };
  }

  return { status: "NONE", matchCount: 0 };
}

// ----------------------------
// MAIN
// ----------------------------
try {

  let safeFirst = escapeDP(firstName);
  let safeLast = escapeDP(lastName);
  let safeZip = escapeDP(zipCode);

  // ----------------------------
  // RSVP → ACTIVITY CODE
  // ----------------------------
  let activityCode;

  if (rsvp.toLowerCase() === "yes") {
    activityCode = "TEST_EVENT_RSVP_YES";
  } else if (rsvp.toLowerCase() === "no") {
    activityCode = "TEST_EVENT_RSVP_NO";
  } else {
    throw new Error(`Unexpected RSVP value: ${rsvp}`);
  }

  // ----------------------------
  // STEP 1: SQL (email + last)
  // ----------------------------
  let result = await sqlSearch(email, safeLast);

  let donorId = result.donorId;

  // ----------------------------
  // STEP 2: SQL (email + last + first)
  // ----------------------------
  if (!donorId) {
    result = await sqlSearch(email, safeLast, safeFirst);
    donorId = result.donorId;
  }

  // ----------------------------
  // STEP 3: FALLBACK dp_donorsearch
  // ----------------------------
  let matchCount = null;

  if (!donorId) {
    let fallback = await dpSearch(firstName, lastName, zipCode);

    matchCount = fallback.matchCount;

    if (fallback.status === "REVIEW") {
      await updateStatus(
        "REVIEW",
        `Multiple donor matches found (${matchCount}). Manual review required.`,
        matchCount
      );
      return;
    }

    donorId = fallback.donorId;
  }

  // ----------------------------
  // CREATE DONOR IF STILL NONE
  // ----------------------------
  if (!donorId) {

let createURL =
  `${DP_ENDPOINT}?apikey=${API_KEY}` +
  `&action=dp_savedonor` +
  `&params=` +
  `@donor_id=0,` +
  `@first_name='${safeFirst}',` +
  `@last_name='${safeLast}',` +
  `@middle_name=null,` +
  `@suffix=null,` +
  `@title=null,` +
  `@salutation=null,` +
  `@prof_title=null,` +
  `@opt_line=null,` +
  `@address=null,` +
  `@address2=null,` +
  `@city=null,` +
  `@state=null,` +
  `@zip='${safeZip}',` +
  `@country='US',` +
  `@address_type=null,` +
  `@home_phone=null,` +
  `@business_phone=null,` +
  `@fax_phone=null,` +
  `@mobile_phone=null,` +
  `@email='${escapeDP(email)}',` +
  `@org_rec='N',` +
  `@donor_type='IN',` +
  `@nomail='N',` +
  `@nomail_reason=null,` +
  `@narrative='Created via Airtable API Integration',` +
  `@donor_rcpt_type='C',` +
  `@user_id='${USER_ID}'`;

 let res = await fetch(createURL);
  let xml = await res.text();

  let donorIdMatch = xml.match(/value=['"](\d+)['"]/);

  if (!donorIdMatch) {
    await updateStatus(
      "FAILED",
      `Donor creation failed: ${xml}`,
      0
    );
    return;
  }

donorId = donorIdMatch[1];
  }

  // ----------------------------
  // CREATE CONTACT
  // ----------------------------
  let commentText = `Event: ${eventName} | RSVP: ${rsvp}`;

  let today = new Date().toISOString().split("T")[0];

let contactURL =
  `${DP_ENDPOINT}?apikey=${API_KEY}` +
  `&action=dp_savecontact` +
  `&params=` +
  `@contact_id=0,` +
  `@donor_id=${donorId},` +
  `@activity_code='${activityCode}',` +
  `@mailing_code=null,` +
  `@by_whom='${USER_ID}',` +
  `@contact_date='${today}',` +
  `@due_date=null,` +
  `@due_time=null,` +
  `@completed_date=null,` +
  `@document_path=null,` +
  `@comment='${escapeDP(commentText)}',` +
  `@user_id='${USER_ID}'`;

  let contactResponse = await fetch(contactURL);
  let contactXML = await contactResponse.text();
let contactIdMatch = contactXML.match(/value=['"](\d+)['"]/);

if (!contactIdMatch) {
  await updateStatus(
    "FAILED",
    `CONTACT RESPONSE: ${contactXML}`,
    matchCount
  );
  return;
}

let contactId = contactIdMatch[1];

//Update the Last Synched Attended Field and Last Synched RSVP for the Record Edit Automation
await table.updateRecordAsync(recordId, {
  "Last Synced RSVP": rsvp,
  "Last Synced Attendance": "To Be Filled Out"
});

let finalMessage =
    matchCount === 0
      ? `New donor created and contact record added. Donor ID: ${donorId}`
      : `Existing donor matched and contact record added. Donor ID: ${donorId}`;

  await updateStatus(
    "SUCCESS",
    finalMessage,
    matchCount
  );


} catch (error) {
  await updateStatus("FAILED", error.toString(), 0);
}
